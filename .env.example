COMPOSE_PROJECT_NAME=swarm-vm
COORDINATOR_BIND_HOST=127.0.0.1
COORDINATOR_PORT=4100
CONTENT_BIND_HOST=127.0.0.1
CONTENT_PORT=8088
SWARM_TENANT=control12
SWARM_COMPACT_AFTER_RECORDS=500
# Configure only after provisioning independently pinned keys and mounting them into the coordinator.
SWARM_AVRONE_ISSUER_PUBLIC_KEY_FILE=
SWARM_CAPABILITY_AUTHORITY_PUBLIC_KEY_B64=
SWARM_RECEIPT_SIGNING_PRIVATE_KEY_FILE=
SWARM_EXECUTOR_PUBLIC_KEY_FILE=
SWARM_EXECUTOR_ID=spiffe://prod/agent/grok-bot
SWARM_AVRONE_ISSUER=spiffe://prod/agent/avrone
SWARM_SERVICE_IDENTITY=spiffe://prod/agent/swarm
SWARM_CAPABILITY_AUTHORITY_ISSUER=spiffe://prod/broker
# Generate each independently with: openssl rand -hex 32
SWARM_API_TOKEN=
SWARM_READ_TOKEN=
SWARM_RUNNER_TOKEN=
SWARM_DEBUGGER_TOKEN=
SWARM_CODER_TOKEN=
SWARM_TESTER_TOKEN=
SWARM_GOVERNANCE_TOKEN=
PRODUCTION=0
GITHUB_REPOSITORY=doitupsolutions810-crow/control12-workspace
GITHUB_RUNNER_NAME=control12-swarm-1
GITHUB_RUNNER_LABELS=self-hosted,linux,x64,control12,swarm
GITHUB_RUNNER_TOKEN=
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=

# Grok Bot specialist execution bridge (must match Grok Bot .env)
SWARM_EXECUTOR_URL=http://grok-bot:3000/api/swarm/execute
SWARM_EXECUTOR_DEBUGGER_TOKEN=
SWARM_EXECUTOR_CODER_TOKEN=
SWARM_EXECUTOR_TESTER_TOKEN=
SWARM_EXECUTOR_GOVERNANCE_TOKEN=
SWARM_INTEGRATION_NETWORK=swarm-integration

# Host paths for docker-compose.swarm.yml secret mounts (never commit these files)
SWARM_AVRONE_ISSUER_PUBLIC_KEY_HOST_FILE=
SWARM_RECEIPT_SIGNING_PRIVATE_KEY_HOST_FILE=
SWARM_EXECUTOR_PUBLIC_KEY_HOST_FILE=

# Live four-role acceptance smoke task. Must match Grok Bot SWARM_DEFAULT_REPOSITORY/BRANCH.
SWARM_SMOKE_REPOSITORY=
SWARM_SMOKE_BRANCH=
SWARM_SMOKE_TIMEOUT_MS=900000
SWARM_SMOKE_POLL_MS=2000

# Internal runner lease lifecycle. Heartbeat must be less than half the lease duration.
RUNNER_LEASE_MS=30000
RUNNER_HEARTBEAT_MS=10000
POLL_MS=3000
